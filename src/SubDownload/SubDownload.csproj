<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SubDownload</RootNamespace>
    <AssemblyName>SubDownload</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>SubDownload</Product>
    <Description>Baixa legenda em portugues (Brasil) do subtitlecat.com para o arquivo de video selecionado no Explorer.</Description>
    <ApplicationIcon>..\..\assets\SubDownload.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
